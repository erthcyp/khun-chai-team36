{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p dashboard-dist && cp ../../tcc/dashboard/index.html ../../tcc/dashboard/dashboard.js ../../tcc/dashboard/styles.css dashboard-dist/",
  "outputDirectory": "dashboard-dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://remark-separate-bookmark-integrity.trycloudflare.com/health"
    },
    {
      "source": "/api/v1/cameras",
      "destination": "https://remark-separate-bookmark-integrity.trycloudflare.com/api/v1/cameras"
    },
    {
      "source": "/api/v1/alerts",
      "destination": "https://remark-separate-bookmark-integrity.trycloudflare.com/api/v1/alerts"
    },
    {
      "source": "/api/v1/metrics",
      "destination": "https://remark-separate-bookmark-integrity.trycloudflare.com/api/v1/metrics"
    },
    {
      "source": "/api/v1/snapshots/:cameraId",
      "destination": "https://remark-separate-bookmark-integrity.trycloudflare.com/api/v1/snapshots/:cameraId"
    }
  ]
}
